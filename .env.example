# Server-only configuration. Copy this file to .env and use your own keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# auto chooses a configured voice service; without keys it uses the browser.
# Choose openai, elevenlabs, or browser explicitly in the teacher connection panel.
VOICE_PROVIDER=auto
OPENAI_VOICE=onyx
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=whisper-1
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
# auto uses live understanding when OpenAI is configured; true is practice only.
DEMO_MODE=auto
PORT=5175
HOST=127.0.0.1
DATABASE_PATH=./data/merit-lens.sqlite


# Hosted demo only. Keep local defaults for normal development.
TRUST_PROXY=0
REQUIRE_DEMO_ACCESS_PASSWORD=false
DEMO_ACCESS_PASSWORD=
